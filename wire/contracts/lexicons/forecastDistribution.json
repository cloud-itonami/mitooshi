{
  "lexicon" : 1,
  "id" : "com.etzhayyim.mitooshi.forecastDistribution",
  "defs" : {
    "main" : {
      "type" : "record",
      "key" : "tid",
      "record" : {
        "type" : "object",
        "required" : [ "forecastId", "seriesId", "distKind", "use", "pointAsserted", "infoAsOf", "horizon" ],
        "properties" : {
          "infoAsOf" : {
            "type" : "integer",
            "description" : "G5 — latest observation ts the forecaster could see; the leak boundary"
          },
          "quantiles" : {
            "type" : "string",
            "description" : "quantile — edn map level→value"
          },
          "mean" : {
            "type" : "number",
            "description" : "gaussian"
          },
          "seriesId" : {
            "type" : "string",
            "description" : "→ :series/id"
          },
          "use" : {
            "type" : "string",
            "enum" : [ "resilience", "planning", "nowcast", "early-warning", "research" ],
            "description" : "G2 INVARIANT — non-speculative use ONLY; trade/speculation/wager/position are NOT enum members (mitooshi never trades, §1.3 + yobel)"
          },
          "modelId" : {
            "type" : "string",
            "description" : "→ :fc.model/id"
          },
          "horizon" : {
            "type" : "integer",
            "description" : "lead time in series-freq steps"
          },
          "probs" : {
            "type" : "string",
            "description" : "categorical — edn map class→prob (Σ=1)"
          },
          "sd" : {
            "type" : "number",
            "description" : "gaussian — strictly > 0"
          },
          "distKind" : {
            "type" : "string",
            "enum" : [ "gaussian", "quantile", "categorical", "ensemble" ]
          },
          "forecastId" : {
            "type" : "string",
            "description" : "→ :forecast/id"
          },
          "sourcing" : {
            "type" : "string",
            "enum" : [ "representative", "verified" ]
          },
          "pointAsserted" : {
            "type" : "boolean",
            "const" : false,
            "description" : "G1 INVARIANT — only false is valid. A deterministic single-future assertion is unrepresentable (非終末論). Every forecast is a distribution."
          },
          "members" : {
            "type" : "string",
            "description" : "ensemble — edn vector of member values; scored by energy-form CRPS"
          }
        }
      }
    }
  }
}
